{
  "name": "peopleflow",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev -w @peopleflow/api\" \"npm run dev -w @peopleflow/web\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run test && npm run typecheck && npm run build",
    "db:start": "supabase start",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "@types/node": "latest",
    "concurrently": "latest",
    "supabase": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
