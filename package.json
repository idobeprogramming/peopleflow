{
  "name": "peopleflow",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c blue,green \"npm run dev -w @peopleflow/api\" \"npm run dev -w @peopleflow/web\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run test && npm run typecheck && npm run build",
    "dev:local": "supabase start && supabase migration up --local && node scripts/dev-local.mjs",
    "test:demo": "node --experimental-strip-types --test demo/directory.test.mjs",
    "test:agent": "node --test scripts/agent/lib.test.mjs",
    "test:e2e": "playwright test",
    "test:integration": "node scripts/with-local-supabase.mjs vitest run apps/api/src/employees/supabase.integration.test.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "supabase": "^3.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
