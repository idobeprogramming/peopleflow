# Optional for local Supabase-backed persistence. Keep service keys server-side.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
WEB_ORIGIN=http://localhost:5173
PORT=3000
# Show the public demo credentials on the login page. Never enable with real accounts.
DEMO_ACCOUNT=true
# Read the client IP from X-Forwarded-For; only behind a trusted reverse proxy.
TRUST_PROXY=false
